
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local LocalPlayer = Players.LocalPlayer
local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")

-- CONFIGURATION
local MAX_DISTANCE = 1500
local UPDATE_INTERVAL = 0.15

local ESP_ENABLED = true
local RECORDING_MODE = false

local Billboards = {}
local Connections = {}

--// CLEANUP
local function removeESP(player)
    local data = Billboards[player]

    if data then
        data.Gui:Destroy()
        Billboards[player] = nil
    end
end

--// CREATE PLAYER ESP
local function createESP(player, character)

    local root = character:WaitForChild("HumanoidRootPart", 10)

    if not root or player.Character ~= character then
        return
    end

    removeESP(player)

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "DevESP"
    billboard.Adornee = root
    billboard.Size = UDim2.fromOffset(220, 45)
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.AlwaysOnTop = true
    billboard.LightInfluence = 0
    billboard.MaxDistance = MAX_DISTANCE

    local label = Instance.new("TextLabel")
    label.Size = UDim2.fromScale(1, 1)
    label.BackgroundTransparency = 1

    label.TextColor3 = Color3.fromRGB(255, 100, 100)
    label.TextStrokeTransparency = 0.25

    label.Font = Enum.Font.GothamBold
    label.TextSize = 14
    label.TextWrapped = true

    label.Parent = billboard
    billboard.Parent = PlayerGui

    Billboards[player] = {
        Gui = billboard,
        Label = label
    }
end

--// PLAYER CONNECTIONS
local function setupPlayer(player)

    if player == LocalPlayer then
        return
    end

    Connections[player] = {
        player.CharacterAdded:Connect(function(character)
            task.spawn(createESP, player, character)
        end),

        player.CharacterRemoving:Connect(function()
            removeESP(player)
        end)
    }

    if player.Character then
        task.spawn(createESP, player, player.Character)
    end
end

for _, player in ipairs(Players:GetPlayers()) do
    setupPlayer(player)
end

Players.PlayerAdded:Connect(setupPlayer)

Players.PlayerRemoving:Connect(function(player)

    removeESP(player)

    if Connections[player] then
        for _, connection in ipairs(Connections[player]) do
            connection:Disconnect()
        end

        Connections[player] = nil
    end
end)

--// CONTROL PANEL
local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "DevESPControls"
ScreenGui.ResetOnSpawn = false
ScreenGui.Parent = PlayerGui

local Panel = Instance.new("Frame")
Panel.Size = UDim2.fromOffset(236, 154)
Panel.Position = UDim2.fromOffset(20, 70)
Panel.BackgroundColor3 = Color3.fromRGB(20, 20, 27)
Panel.BackgroundTransparency = 0.1
Panel.Parent = ScreenGui

local Corner = Instance.new("UICorner")
Corner.CornerRadius = UDim.new(0, 10)
Corner.Parent = Panel

local function makeButton(text, y)

    local button = Instance.new("TextButton")

    button.Size = UDim2.new(1, -20, 0, 30)
    button.Position = UDim2.fromOffset(10, y)

    button.BackgroundColor3 = Color3.fromRGB(45, 45, 60)
    button.TextColor3 = Color3.new(1, 1, 1)

    button.Font = Enum.Font.GothamBold
    button.TextSize = 12
    button.Text = text

    button.Parent = Panel

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = button

    return button
end

local Title = Instance.new("TextLabel")
Title.Size = UDim2.new(1, 0, 0, 28)
Title.BackgroundTransparency = 1
Title.Text = "DEV ESP"
Title.TextColor3 = Color3.fromRGB(100, 200, 255)
Title.Font = Enum.Font.GothamBold
Title.TextSize = 16
Title.Parent = Panel

local ESPButton = makeButton("ESP: ON [F6]", 36)
local RecordButton = makeButton("Recording: OFF [F8]", 74)

--// UPDATE CONTROLS
local function refresh()

    ESPButton.Text = ESP_ENABLED
        and "ESP: ON [F6]"
        or "ESP: OFF [F6]"

    RecordButton.Text = RECORDING_MODE
        and "Recording: ON [F8]"
        or "Recording: OFF [F8]"

    -- Hide control panel during recording
    Panel.Visible = not RECORDING_MODE
end

ESPButton.MouseButton1Click:Connect(function()
    ESP_ENABLED = not ESP_ENABLED
    refresh()
end)

RecordButton.MouseButton1Click:Connect(function()
    RECORDING_MODE = not RECORDING_MODE
    refresh()
end)

--// KEYBOARD CONTROLS
UserInputService.InputBegan:Connect(function(input, processed)

    if processed then
        return
    end

    if input.KeyCode == Enum.KeyCode.F6 then

        ESP_ENABLED = not ESP_ENABLED
        refresh()

    elseif input.KeyCode == Enum.KeyCode.F8 then

        RECORDING_MODE = not RECORDING_MODE
        refresh()

    end
end)

--// OPTIMIZED ESP UPDATE LOOP
task.spawn(function()

    while true do

        for player, data in pairs(Billboards) do

            local character = player.Character
            local root = character
                and character:FindFirstChild("HumanoidRootPart")

            local myCharacter = LocalPlayer.Character
            local myRoot = myCharacter
                and myCharacter:FindFirstChild("HumanoidRootPart")

            local visible = false

            if root and myRoot then

                local distance = (root.Position - myRoot.Position).Magnitude

                visible =
                    ESP_ENABLED
                    and not RECORDING_MODE
                    and distance <= MAX_DISTANCE

                if visible then

                    data.Label.Text = string.format(
                        "%s  |  %d studs",
                        player.DisplayName,
                        distance
                    )

                    if player.Team == LocalPlayer.Team then
                        data.Label.TextColor3 =
                            Color3.fromRGB(100, 200, 255)
                    else
                        data.Label.TextColor3 =
                            Color3.fromRGB(255, 100, 100)
                    end

                end
            end

            data.Gui.Enabled = visible
        end

        task.wait(UPDATE_INTERVAL)
    end
end)

refresh()

print("[DEV ESP] Successfully loaded!")
