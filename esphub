-- ESP SYSTEM
local function setupPlayer(player)
    if player == LP then return end

    local function setupCharacter(character)
        local old = Tracked[player]
        if old then
            if old.highlight then old.highlight:Destroy() end
            if old.billboard then old.billboard:Destroy() end
        end

        local head = character:WaitForChild("Head", 5)
        if not head then return end

        local highlight = Instance.new("Highlight")
        highlight.Name = "CustomPlayerESP"
        highlight.Adornee = character
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        highlight.FillTransparency = 0.5
        highlight.Parent = character

        local billboard = Instance.new("BillboardGui")
        billboard.Name = "ESPDisplay"
        billboard.Adornee = head
        billboard.Size = UDim2.fromOffset(180, 35)
        billboard.StudsOffset = Vector3.new(0, 2.5, 0)
        billboard.AlwaysOnTop = true
        billboard.Parent = head

        local label = Instance.new("TextLabel")
        label.Size = UDim2.fromScale(1, 1)
        label.BackgroundTransparency = 1
        label.TextColor3 = Color3.new(1, 1, 1)
        label.TextStrokeTransparency = 0
        label.Font = Enum.Font.GothamBold
        label.TextScaled = true
        label.Parent = billboard

        Tracked[player] = {
            highlight = highlight,
            billboard = billboard,
            label = label,
            character = character
        }
    end

    if player.Character then
        setupCharacter(player.Character)
    end

    player.CharacterAdded:Connect(setupCharacter)
end

for _, player in ipairs(Players:GetPlayers()) do
    setupPlayer(player)
end

Players.PlayerAdded:Connect(setupPlayer)

Players.PlayerRemoving:Connect(function(player)
    local data = Tracked[player]
    if data then
        data.highlight:Destroy()
        data.billboard:Destroy()
        Tracked[player] = nil
    end
end)

RunService.RenderStepped:Connect(function()
    local myChar = LP.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    for player, data in pairs(Tracked) do
        local char = data.character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local humanoid = char and char:FindFirstChildOfClass("Humanoid")

        local distance = root and (myRoot.Position - root.Position).Magnitude
        local visible = ESP and root and humanoid
            and humanoid.Health > 0 and distance <= MaxDistance

        data.highlight.Enabled = not not visible
        data.billboard.Enabled = not not visible

        if visible then
            local color = Color3.fromRGB(255, 45, 45)

            if TeamColors and LP.Team ~= nil
                and player.Team == LP.Team then
                color = Color3.fromRGB(40, 255, 100)
            end

            data.highlight.FillColor = color
            data.highlight.OutlineColor = color

            data.label.TextColor3 = color
            data.label.Text = player.Name ..
                (ShowDistance and
                ("\n" .. math.floor(distance) .. " studs") or "")
        end
    end
end)

